<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WorldEditorRoot>$(MSBuildThisFileDirectory)..\</WorldEditorRoot>
    <WorldEditorDataDirectory Condition="'$(WorldEditorDataDirectory)'==''">D:\ymir work</WorldEditorDataDirectory>
    <OutDir>$(WorldEditorRoot).build\lib\$(Platform)\$(Configuration)\</OutDir>
    <OutDir Condition="'$(MSBuildProjectName)'=='WorldEditor'">$(WorldEditorDataDirectory)\</OutDir>
    <IntDir>$(WorldEditorRoot).build\obj\$(MSBuildProjectName)\$(Platform)\$(Configuration)\</IntDir>
    <LocalDebuggerWorkingDirectory>$(WorldEditorDataDirectory)</LocalDebuggerWorkingDirectory>
    <VcpkgEnabled>false</VcpkgEnabled>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>WORLD_EDITOR;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(WorldEditorRoot)Extern\include;$(WorldEditorRoot)Extern\include\Python27;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <ProgramDataBaseFileName>$(IntDir)$(MSBuildProjectName).pdb</ProgramDataBaseFileName>
      <PrecompiledHeaderOutputFile>$(IntDir)$(MSBuildProjectName).pch</PrecompiledHeaderOutputFile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
    </ClCompile>
    <Link>
      <ProgramDatabaseFile Condition="'$(MSBuildProjectName)'=='WorldEditor'">$(IntDir)$(TargetName).pdb</ProgramDatabaseFile>
      <ImportLibrary Condition="'$(MSBuildProjectName)'=='WorldEditor'">$(IntDir)$(TargetName).lib</ImportLibrary>
      <AdditionalLibraryDirectories Condition="'$(Platform)'=='x64'">$(WorldEditorRoot)Extern\lib\x64;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalLibraryDirectories Condition="'$(Platform)'!='x64'">$(WorldEditorRoot)Extern\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <IgnoreSpecificDefaultLibraries Condition="'$(Configuration)'=='WE-Debug' And '$(Platform)'!='x64'">libcmt.lib;%(IgnoreSpecificDefaultLibraries)</IgnoreSpecificDefaultLibraries>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Platform)'!='x64'">
    <ClCompile>
      <PreprocessorDefinitions>GRANNY_STATIC;SPEEDTREE_STATIC;Py_NO_ENABLE_SHARED;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Platform)'=='x64'">
    <ClCompile>
      <PreprocessorDefinitions>GRANNY_STATIC;Py_NO_ENABLE_SHARED;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Platform)'=='x64' And '$(Configuration)'=='WE-Debug'">
    <ClCompile>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <PreprocessorDefinitions>_ITERATOR_DEBUG_LEVEL=0;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <UndefinePreprocessorDefinitions>_DEBUG;%(UndefinePreprocessorDefinitions)</UndefinePreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
